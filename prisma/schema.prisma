generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Outlet {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  address      String?
  email        String?        @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  staffCount   Int            @default(0)
  phone        String?
  expenses     Expense[]
  inventories  Inventory[]
  orders       Order[]
  products     Product[]
  StockHistory StockHistory[]
  users        User[]         @relation("OutletUsers")
  admins       AdminOutlet[]  @relation("OutletAdmins")
  coupons      Coupon[]
  availability OutletAvailability[]
  notifications Notification[]
  scheduledNotifications ScheduledNotification[]
  appManagement OutletAppManagement[]
  // New inventory system
  inventoryItems       InventoryItem[]
  inventoryItemHistory InventoryItemHistory[]
  expenseCategories    ExpenseCategory[]
  expenseNames         ExpenseName[]
  vendors              Vendor[]
}

model User {
  id           Int              @id @default(autoincrement())
  email        String           @unique
  name         String
  password     String?
  role         Role             @default(CUSTOMER)
  googleId     String?          @unique
  outletId     Int?
  createdAt    DateTime         @default(now())
  phone        String?
  isVerified   Boolean          @default(false)
  imageUrl     String?
  customerInfo CustomerDetails?
  staffInfo    StaffDetails?
  outlet       Outlet?          @relation("OutletUsers", fields: [outletId], references: [id], onDelete: Cascade)
  deviceTokens UserDeviceToken[]
  notificationDeliveries NotificationDelivery[]
}

model CustomerDetails {
  id          Int           @id @default(autoincrement())
  userId      Int           @unique
  orderCount  Int           @default(0)
  yearOfStudy Int?
  degree      typeOfDegree?
  bio         String?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]       @relation("CustomerOrders")
  tickets     Ticket[]      @relation("CustomerTickets")
  wallet      Wallet?
  cart        Cart?
}

model StaffDetails {
  id                   Int               @id @default(autoincrement())
  userId               Int               @unique
  staffRole            String            @default("Staff")
  aadharUrl            String?
  panUrl               String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean           @default(false)
  twoFactorBackupCodes Json?
  twoFactorEnabledAt   DateTime?
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions          StaffPermission[]
}

model StaffPermission {
  id        Int            @id @default(autoincrement())
  staffId   Int
  type      PermissionType
  isGranted Boolean        @default(false)
  staff     StaffDetails   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Cart {
  id         Int             @id @default(autoincrement())
  customerId Int             @unique
  customer   CustomerDetails @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation("ProductCartItems", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Product {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  description      String?
  price            Float
  imageUrl         String?
  outletId         Int
  category         Category
  minValue         Int?            @default(0)
  recipeConfigured Boolean         @default(false)
  inventory        Inventory?
  orderItems       OrderItem[]     @relation("ProductToOrderItems")
  outlet           Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  StockHistory     StockHistory[]
  cartItems        CartItem[]      @relation("ProductCartItems")
  notifications    Notification[]
  recipes          ProductRecipe[]
}

model Inventory {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  outletId  Int
  quantity  Int
  threshold Int
  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockHistory {
  id        Int         @id @default(autoincrement())
  productId Int
  outletId  Int
  quantity  Int
  action    StockAction
  timestamp DateTime    @default(now())
  outlet    Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ── NEW: Raw-material Inventory ────────────────────────────────────────────────

model InventoryItem {
  id               Int                    @id @default(autoincrement())
  outletId         Int
  itemName         String
  itemCategory     String                 @default("Other")
  stockUnit        String
  currentStock     Float                  @default(0)
  reorderThreshold Float                  @default(0)
  costPerUnit      Float                  @default(0)
  status           InventoryItemStatus    @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  outlet           Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recipeRows       ProductRecipe[]
  stockMovements   InventoryItemHistory[]
  linkedExpenseNames ExpenseName[]
  expenseEntries   Expense[]

  @@unique([outletId, itemName])
}

model InventoryItemHistory {
  id              Int            @id @default(autoincrement())
  inventoryItemId Int
  outletId        Int
  movementType    MovementType
  quantity        Float
  unit            String
  source          MovementSource
  referenceId     String?
  remarks         String?
  createdAt       DateTime       @default(now())
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  outlet          Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model ProductRecipe {
  id                 Int            @id @default(autoincrement())
  productId          Int
  inventoryItemId    Int
  itemType           RecipeItemType
  quantityPerServing Float
  unit               String
  costPerUnit        Float          @default(0)
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryItemId])
}

// ── NEW: Expenditure Masters ───────────────────────────────────────────────────

model ExpenseCategory {
  id               Int           @id @default(autoincrement())
  outletId         Int
  name             String
  isStockAffecting Boolean       @default(false)
  createdAt        DateTime      @default(now())
  outlet           Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  expenseNames     ExpenseName[]

  @@unique([outletId, name])
}

model ExpenseName {
  id                    Int             @id @default(autoincrement())
  outletId              Int
  categoryId            Int
  name                  String
  linkedInventoryItemId Int?
  createdAt             DateTime        @default(now())
  outlet                Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category              ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItem         InventoryItem?  @relation(fields: [linkedInventoryItemId], references: [id])

  @@unique([outletId, categoryId, name])
}

model Vendor {
  id        Int      @id @default(autoincrement())
  outletId  Int
  name      String
  createdAt DateTime @default(now())
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, name])
}

// ── Extended Expense model ────────────────────────────────────────────────────

model Expense {
  id                    Int            @id @default(autoincrement())
  outletId              Int
  description           String
  category              String
  amount                Float
  method                PaymentMethod
  paidTo                String
  expenseDate           DateTime
  createdAt             DateTime       @default(now())
  quantity              Float?
  unit                  String?
  unitPrice             Float?
  vendorName            String?
  billUrl               String?
  expenseNameId         Int?
  linkedInventoryItemId Int?
  linkedInventoryItem   InventoryItem? @relation(fields: [linkedInventoryItemId], references: [id])
  outlet                Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model Order {
  id                Int              @id @default(autoincrement())
  customerId        Int?
  outletId          Int
  totalAmount       Float
  paymentMethod     PaymentMethod
  status            OrderStatus
  createdAt         DateTime         @default(now())
  type              OrderType
  deliveryDate      DateTime?
  deliverySlot      DeliverySlot?
  isPreOrder        Boolean          @default(false)
  razorpayPaymentId String?
  deliveredAt       DateTime?
  customer          CustomerDetails? @relation("CustomerOrders", fields: [customerId], references: [id])
  outlet            Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items             OrderItem[]
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Float
  status    OrderItemStatus @default(NOT_DELIVERED)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation("ProductToOrderItems", fields: [productId], references: [id], onDelete: Cascade)
}

model Wallet {
  id             Int                 @id @default(autoincrement())
  customerId     Int                 @unique
  balance        Float               @default(0)
  totalRecharged Float               @default(0)
  totalUsed      Float               @default(0)
  lastRecharged  DateTime?
  lastOrder      DateTime?
  customer       CustomerDetails     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]
}

model WalletTransaction {
  id                Int             @id @default(autoincrement())
  walletId          Int
  amount            Float
  grossAmount       Float?
  serviceCharge     Float?
  method            PaymentMethod
  razorpayPaymentId String?
  razorpayOrderId   String?
  createdAt         DateTime        @default(now())
  status            WalletTransType
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Ticket {
  id             Int             @id @default(autoincrement())
  customerId     Int
  title          String
  description    String
  priority       Priority
  status         TicketStatus    @default(OPEN)
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?
  resolutionNote String?
  customer       CustomerDetails @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  imageUrl       String?
}

model Coupon {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  description   String
  rewardValue   Float
  minOrderValue Float
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean       @default(true)
  usageLimit    Int
  usedCount     Int           @default(0)
  usageType     String?
  outletId      Int?
  outlet        Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  usages        CouponUsage[]
  createdAt     DateTime      @default(now())
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  couponId Int
  orderId  Int
  userId   Int
  amount   Float
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
}

model Admin {
  id          Int               @id @default(autoincrement())
  email       String            @unique
  name        String
  password    String
  phone       String?
  isVerified  Boolean           @default(false)
  imageUrl    String?
  aadharUrl   String?
  panUrl      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  outlets     AdminOutlet[]
  permissions AdminPermission[] @relation("AdminPermissions")
}

model AdminOutlet {
  id          Int               @id @default(autoincrement())
  adminId     Int
  outletId    Int
  admin       Admin             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  outlet      Outlet            @relation("OutletAdmins", fields: [outletId], references: [id], onDelete: Cascade)
  permissions AdminPermission[] @relation("AdminOutletPermissions")

  @@unique([adminId, outletId])
}

model AdminPermission {
  id            Int                 @id @default(autoincrement())
  adminOutletId Int
  adminId       Int?
  type          AdminPermissionType
  isGranted     Boolean             @default(false)
  admin         Admin?              @relation("AdminPermissions", fields: [adminId], references: [id], onDelete: Cascade)
  AdminOutlet   AdminOutlet         @relation("AdminOutletPermissions", fields: [adminOutletId], references: [id], onDelete: Cascade)

  @@unique([adminOutletId, type])
}

model OutletAvailability {
  id                Int      @id @default(autoincrement())
  outletId          Int
  date              DateTime
  nonAvailableSlots Json     @db.Json
  outlet            Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, date])
  @@index([outletId, date])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  productId Int
  outletId  Int
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model ScheduledNotification {
  id          Int                    @id @default(autoincrement())
  title       String
  message     String
  priority    Priority
  imageUrl    String?
  scheduledAt DateTime
  sentAt      DateTime?
  isSent      Boolean                @default(false)
  outletId    Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  outlet      Outlet                 @relation(fields: [outletId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]
}

model NotificationDelivery {
  id                      Int                   @id @default(autoincrement())
  scheduledNotificationId Int
  userId                  Int
  deviceToken             String
  status                  NotificationStatus    @default(PENDING)
  sentAt                  DateTime?
  failureReason           String?
  messageId               String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  scheduledNotification   ScheduledNotification @relation(fields: [scheduledNotificationId], references: [id], onDelete: Cascade)
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduledNotificationId, userId, deviceToken])
  @@index([scheduledNotificationId, status])
  @@index([userId, status])
}

model UserDeviceToken {
  id          Int      @id @default(autoincrement())
  userId      Int
  deviceToken String   @unique
  platform    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutletAppManagement {
  id        Int              @id @default(autoincrement())
  outletId  Int
  feature   OutletAppFeature
  isEnabled Boolean          @default(false)
  outlet    Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, feature])
  @@index([outletId, feature])
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum typeOfDegree {
  UG
  PG
}

enum OrderType {
  MANUAL
  APP
}

enum OrderItemStatus {
  NOT_DELIVERED
  DELIVERED
}

enum Role {
  CUSTOMER
  STAFF
  SUPERADMIN
}

enum AdminPermissionType {
  ORDER_MANAGEMENT
  STAFF_MANAGEMENT
  INVENTORY_MANAGEMENT
  EXPENDITURE_MANAGEMENT
  WALLET_MANAGEMENT
  CUSTOMER_MANAGEMENT
  TICKET_MANAGEMENT
  NOTIFICATIONS_MANAGEMENT
  PRODUCT_MANAGEMENT
  APP_MANAGEMENT
  REPORTS_ANALYTICS
  SETTINGS
  ONBOARDING
  ADMIN_MANAGEMENT
}

enum PermissionType {
  BILLING
  PRODUCT_INSIGHTS
  REPORTS
  INVENTORY
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  WALLET
}

enum OrderStatus {
  PENDING
  DELIVERED
  PARTIALLY_DELIVERED
  PARTIAL_CANCEL
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  Meals
  Starters
  Desserts
  Beverages
  Combo
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum StockAction {
  ADD
  REMOVE
  UPDATE
}

enum WalletTransType {
  RECHARGE
  DEDUCT
}

enum DeliverySlot {
  SLOT_11_12
  SLOT_12_13
  SLOT_13_14
  SLOT_14_15
  SLOT_15_16
  SLOT_16_17
}

enum OutletAppFeature {
  APP
  UPI
  LIVE_COUNTER
  COUPONS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

// ── New Enums ──────────────────────────────────────────────────────────────────


enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  INWARD
  OUTWARD
}

enum MovementSource {
  EXPENDITURE_ENTRY
  MANUAL_ADD
  APP_SALE
  POS_SALE
  MANUAL_DEDUCTION
  CANCELLATION_REVERSAL
}

enum RecipeItemType {
  RAW_MATERIAL
  SERVING_ITEM
  PACKAGING_ITEM
}

// ── Authentication & Security ────────────────────────────────────────────────

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

